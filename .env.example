# mk-traceops — örnek ortam değişkenleri
# Bu dosyayı kopyalayıp .env.local yapın:  cp .env.example .env.local  (veya elle oluşturun)
# .env.local Git’e eklenmez.

# --- Supabase (ileride bağlantı için; şu an uygulama mock veri kullanıyor) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# İsteğe bağlı: sunucu tarafı (service role sadece güvenli ortamda, asla istemciye koymayın)
# SUPABASE_SERVICE_ROLE_KEY=
