# mk-traceops — örnek ortam değişkenleri
# Bu dosyayı kopyalayıp .env.local yapın:  cp .env.example .env.local  (veya elle oluşturun)
# .env.local Git’e eklenmez.

# --- Supabase (src/lib/supabase/*) ---
# Proje → Settings → API: Project URL ve anon public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sunucu tarafı: fabrika onayı / davet kabulünde Auth Admin API (yalnızca güvenli ortam, asla client’a vermeyin)
# SUPABASE_SERVICE_ROLE_KEY=

# Geliştirme: tam giriş akışı yokken profil çerezi ile oturum seçimi (canlıda kapalı tutun)
# RBAC_ALLOW_PROFILE_COOKIE=true
